# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
.agent-device/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.local/

# typescript
*.tsbuildinfo


# generated native folders
/ios
/android
/modules/*/android/build/

.zed/*
.idea/*

# eslint
.eslintcache

# prometheus-context-bootstrap
.prometheus/.writer.lock
.prometheus/.review-pending
.claude/settings.json.bak.*

# Compass knowledge graph: commit configuration and human-readable reports only.
# Everything else (graph.json ~300 MB, SQLite store, snapshots, caches) is regenerated by `compass update .`.
compass-out/*
!compass-out/GRAPH_REPORT.md
!compass-out/orientation.json

# KBD orchestrator runtime locks
.kbd-orchestrator/**/*.lock
