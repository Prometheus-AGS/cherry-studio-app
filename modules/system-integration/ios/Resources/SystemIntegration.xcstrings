    },
    "shareFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Freigabe konnte nicht gelesen werden. Teile bis zu 10 Dateien (je 25 MB, insgesamt 50 MB) und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση αυτής της κοινοποίησης. Κοινοποίησε έως 10 αρχεία (25 MB το καθένα, 50 MB συνολικά) και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read this share. Share up to 10 files (25 MB each, 50 MB total) and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este contenido compartido. Comparte hasta 10 archivos (25 MB cada uno, 50 MB en total) y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce partage. Partagez jusqu'à 10 fichiers (25 Mo chacun, 50 Mo au total) et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有内容を読み取れませんでした。最大10個のファイル（各25MB、合計50MB）を共有してもう一度お試しください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esta partilha. Partilhe até 10 ficheiros (25 MB cada, 50 MB no total) e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut citi această partajare. Partajează până la 10 fișiere (25 MB fiecare, 50 MB în total) și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать этот файл. Поделитесь не более чем 10 файлами (по 25 МБ каждый, всего 50 МБ) и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu paylaşım okunamadı. En fazla 10 dosya (her biri 25 MB, toplam 50 MB) paylaşıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc nội dung chia sẻ này. Hãy chia sẻ tối đa 10 tệp (mỗi tệp 25 MB, tổng cộng 50 MB) và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取分享内容。最多支持 10 个文件，单文件 25 MB、总计 50 MB，请重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取分享內容。最多支援 10 個檔案，單檔 25 MB、總計 50 MB，請重新分享。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
