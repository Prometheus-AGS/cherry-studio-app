    "failed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teilen ist fehlgeschlagen. Öffne The Boss und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κοινοποίηση απέτυχε. Άνοιξε το The Boss και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share failed. Open The Boss and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo compartir. Abre The Boss e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage a échoué. Ouvrez The Boss et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有に失敗しました。The Boss を開いてもう一度お試しください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A partilha falhou. Abra o The Boss e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Partajarea a eșuat. Deschide The Boss și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось поделиться. Откройте The Boss и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım başarısız oldu. The Boss'u açıp tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ không thành công. Hãy mở The Boss và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享失败，请打开 The Boss 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享失敗，請打開 The Boss 後重試。"
          }
        }
      }
    },
