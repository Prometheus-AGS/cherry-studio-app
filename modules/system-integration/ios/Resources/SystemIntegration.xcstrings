    "shareSaved": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt. Öffne The Boss, um fertigzustellen und zu senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστέθηκε. Άνοιξε το The Boss για να το ολοκληρώσεις και να το στείλεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added. Open The Boss to finish it and send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido. Abre The Boss para terminarlo y enviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté. Ouvrez The Boss pour le terminer et l'envoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加しました。The Boss を開いて仕上げて送信してください。"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionado. Abra o The Boss para terminar e enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugat. Deschide The Boss pentru a-l finaliza și trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено. Откройте The Boss, чтобы завершить и отправить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklendi. Tamamlamak ve göndermek için The Boss'u açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã thêm. Hãy mở The Boss để hoàn tất và gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加。打开 The Boss 即可继续编辑并发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已新增。打開 The Boss 即可繼續編輯並傳送。"
          }
        }
      }
    },
    "sharePreparing": {
